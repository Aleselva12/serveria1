# Cora - configurazione locale di esempio
# Copia questo file in .env e modifica i percorsi secondo il computer/server.

# Ollama
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11435

# Documenti locali
# Esempio Windows: C:/Users/Ale/Documents/CoraKnowledge
# Esempio Debian: /srv/cora/knowledge
CORA_KNOWLEDGE_ROOT=./knowledge

# Audio locali
# Esempio Windows: C:/Users/Ale/Documents/CoraAudio
# Esempio Debian: /srv/cora/audio
CORA_AUDIO_ROOT=./audio

# Faster-Whisper
# Può essere un nome modello (small, medium, large-v3...) oppure
# il percorso di un modello già presente in locale.
CORA_WHISPER_MODEL=small
CORA_WHISPER_DEVICE=cpu
CORA_WHISPER_COMPUTE_TYPE=int8

# Diarizzazione speaker
# Percorso LOCALE di un modello pyannote compatibile.
# Lascia vuoto se la diarizzazione non è ancora configurata.
CORA_DIARIZATION_MODEL=

# Limiti del Local Research Agent
CORA_MAX_DOCUMENT_BYTES=5000000
CORA_MAX_DOCUMENT_CHARS=120000
