# Cora - configurazione locale di esempio
# Copia questo file in .env e modifica i percorsi secondo il computer/server.

# Ollama
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11435

# Modelli opzionali per ruolo.
# Se lasciati vuoti, ogni ruolo eredita OLLAMA_MODEL.
CORA_MODEL_SUPERVISOR=
CORA_MODEL_RESEARCH=
CORA_MODEL_AUDIO=
CORA_MODEL_EMAIL=
CORA_MODEL_STRUCTURE=

# Documenti locali
# Empty => ./knowledge, created for local use. An explicit path must exist.
CORA_KNOWLEDGE_ROOT=

# Audio locali
CORA_AUDIO_ROOT=./audio
CORA_TRANSCRIPT_ROOT=./audio/_transcripts

# Faster-Whisper
CORA_WHISPER_MODEL=small
CORA_WHISPER_DEVICE=cpu
CORA_WHISPER_COMPUTE_TYPE=int8

# Diarizzazione speaker
CORA_DIARIZATION_MODEL=

# Gmail
CORA_GMAIL_CREDENTIALS_PATH=./email_agent/credentials.json
CORA_GMAIL_TOKEN_PATH=./email_agent/token.json

# Limite testo email passato al modello
CORA_EMAIL_MAX_BODY_CHARS=6000

# Preventivi PDF
CORA_QUOTE_ROOT=./quotes

# Limiti del Local Research Agent
CORA_MAX_DOCUMENT_BYTES=5000000
CORA_MAX_DOCUMENT_CHARS=120000
CORA_MAX_PDF_PAGES=100


# Logging strutturato locale
CORA_LOG_ROOT=./logs

# Memoria persistente locale
CORA_MEMORY_ROOT=./data
CORA_MEMORY_DB=./data/cora_memory.sqlite3


# Workspace persistente dello Structure Agent
CORA_STRUCTURE_WORKSPACE=./structure_workspace

# Browser origins for direct HTTP access (the Vite proxy needs no change).
CORA_UI_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Home: optional internal health endpoints (set only for installed services).
CORA_SERVICE_IMMICH_URL=
CORA_SERVICE_NEXTCLOUD_URL=
CORA_SERVICE_N8N_URL=

# File server: independent from the IA knowledge root.
# Empty => creates ./data/server_files for local tests.
# Explicit roots must exist; missing mounts are reported, never created.
# Debian example (adapt paths and permissions before enabling):
# CORA_FILE_ROOTS=[{"id":"system","label":"Questo server","path":"/","writable":false},{"id":"drive","label":"Dati","path":"/srv/nas/Dati/drive","writable":true}]
# Windows example: [{"id":"files","label":"File di prova","path":"C:/CORA-Files","writable":true}]
CORA_FILE_ROOTS=
# Required for remote access, including through a local HTTP proxy.
# Send as Authorization: Bearer <token>. Empty => direct loopback requests only.
CORA_FILES_TOKEN=
CORA_FILES_MAX_UPLOAD_BYTES=1073741824

# Direct uploads to Libreria IA also store an original here, visible in File server.
# Empty => ./data/library_originals. Explicit paths must exist.
# Must be separate from CORA_KNOWLEDGE_ROOT (neither nested inside the other).
CORA_LIBRARY_ORIGINALS_ROOT=
