# Generate deploy.env using python deploy/manage.py init; never commit it.
CORA_POSTGRES_PASSWORD=GENERATED_BY_INIT
CORA_RELEASE=local
# api = core; api-audio-cpu = core + offline CPU transcription.
CORA_API_BUILD_TARGET=api
CORA_WHISPER_CPU_THREADS=4
CORA_UID=1000
CORA_GID=1000
CORA_STATE_ROOT=./state
CORA_BIND_ADDRESS=127.0.0.1
CORA_HTTP_PORT=8080
CORA_UI_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORA_COOKIE_SECURE=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:0.6b
CORA_EMBEDDING_MODEL=nomic-embed-text
CORA_MODEL_KEEP_ALIVE=30m
CORA_FILE_ROOTS='[{"id":"drive","label":"Drive NAS","path":"/nas/drive","writable":true},{"id":"cora","label":"Dati Cora","path":"/state/files","writable":true}]'
CORA_DIAGNOSTIC_RETENTION_DAYS=30
CORA_DIAGNOSTIC_JSONL_EXPORT=false
CORA_RUN_TIMEOUT_SECONDS=300
CORA_RUN_QUEUE_SIZE=4
CORA_MODEL_TIMEOUT_SECONDS=180
CORA_DB_POOL_SIZE=2
CORA_CONTEXT_TOKENS=4096
CORA_OUTPUT_TOKENS=512
CORA_BACKGROUND_IDLE_SECONDS=120
CORA_EMBEDDING_BATCH_SIZE=1
CORA_MEMORY_EMBED_TIMEOUT_SECONDS=2
CORA_PERFORMANCE_PROFILE=server-current
CORA_PERFORMANCE_HARDWARE_LABEL=Debian home server current hardware
CORA_PERFORMANCE_GPU_LABEL=CPU only
