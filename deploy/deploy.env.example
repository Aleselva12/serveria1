# Generate deploy.env using python deploy/manage.py init; never commit it.
CORA_POSTGRES_PASSWORD=GENERATED_BY_INIT
CORA_RELEASE=local
# api = core; api-audio-cpu = core + offline CPU transcription.
CORA_API_BUILD_TARGET=api
CORA_WHISPER_CPU_THREADS=4
CORA_UID=1000
CORA_GID=1000
CORA_STATE_ROOT=./state
CORA_BIND_ADDRESS=127.0.0.1
CORA_HTTP_PORT=8090
CORA_UI_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
CORA_COOKIE_SECURE=false
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:0.6b
CORA_EMBEDDING_MODEL=nomic-embed-text
CORA_MODEL_KEEP_ALIVE=30m
CORA_FILE_ROOTS='[{"id":"cora","label":"Dati Cora","path":"/state/files","writable":true}]'
CORA_DIAGNOSTIC_RETENTION_DAYS=30
CORA_DIAGNOSTIC_JSONL_EXPORT=false
# Unlimited inference overrides legacy time/output budgets; context and tool safeguards remain.
CORA_UNLIMITED_GENERATION=true
# Set to 0 to disable the overall run deadline; manual cancellation stays available.
CORA_RUN_TIMEOUT_SECONDS=300
CORA_RUN_QUEUE_SIZE=4
CORA_MODEL_TIMEOUT_SECONDS=180
CORA_DB_POOL_SIZE=2
CORA_CONTEXT_TOKENS=8192
CORA_OUTPUT_TOKENS=512
CORA_BACKGROUND_IDLE_SECONDS=120
CORA_EMBEDDING_BATCH_SIZE=1
CORA_MEMORY_EMBED_TIMEOUT_SECONDS=2
CORA_PERFORMANCE_PROFILE=server-current
CORA_PERFORMANCE_HARDWARE_LABEL=Debian home server current hardware
CORA_PERFORMANCE_GPU_LABEL=CPU only

# Health check dei servizi gia presenti sul server host.
CORA_SERVICE_IMMICH_URL=http://host.docker.internal:2283
CORA_SERVICE_NEXTCLOUD_URL=http://host.docker.internal:11000
CORA_SERVICE_IMMICH_BROWSER_URL=http://100.112.253.3:2283
# Verificare la porta effettiva di Nextcloud prima di usare il pulsante.
CORA_SERVICE_NEXTCLOUD_BROWSER_URL=
# Inserire gli URL solo quando questi applicativi saranno effettivamente ospitati.
CORA_SERVICE_MAGAZZINO_TELE_URL=
CORA_SERVICE_MAGAZZINO_TELE_BROWSER_URL=
CORA_SERVICE_PREVENTIVI_URL=
CORA_SERVICE_PREVENTIVI_BROWSER_URL=
CORA_SERVICE_N8N_URL=

# Optional automatic owner login through host Tailscale Serve only.
# Configure using: python3 deploy/tailscale_login.py --login EMAIL --origin HTTPS_URL
CORA_AUTH_MODE=password
CORA_TAILSCALE_LOGIN=
CORA_TAILSCALE_PROXY_IP=127.0.0.1
CORA_TAILSCALE_PROXY_SECRET=

# Programmer Context Manager: enabled in this example for Phase A validation.
# Updating this template does NOT change an existing server's private deploy.env.
# Disable with CORA_CONTEXT_MANAGER_ENABLED=false to roll back routing.
CORA_CONTEXT_MANAGER_ENABLED=true
CORA_CONTEXT_ROUTER_MODE=semantic
CORA_CONTEXT_ROUTER_MODEL=qwen3:0.6b
CORA_CONTEXT_ROUTER_TIMEOUT_SECONDS=5
