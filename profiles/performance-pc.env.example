# Profilo suggerito per la prova prestazionale sul PC di sviluppo.\n# Copiare questi valori nel proprio .env: non contiene credenziali.\nCORA_PERFORMANCE_PROFILE=pc-max\nCORA_MODEL_KEEP_ALIVE=30m\nCORA_CONTEXT_TOKENS=16384\nCORA_OUTPUT_TOKENS=1024\nCORA_RUN_TIMEOUT_SECONDS=300\nCORA_MODEL_TIMEOUT_SECONDS=120\nCORA_RUN_QUEUE_SIZE=8\n\n# Per il primo confronto usare lo stesso modello per tutti i ruoli.\n# Impostare OLLAMA_MODEL al modello scelto e lasciare vuote le variabili CORA_MODEL_*.\nCORA_MODEL_SUPERVISOR=\nCORA_MODEL_RESEARCH=\nCORA_MODEL_AUDIO=\nCORA_MODEL_EMAIL=\nCORA_MODEL_STRUCTURE=\nCORA_MODEL_PROGRAMMER=\n\n# Etichette facoltative mostrate insieme ai risultati.\nCORA_PERFORMANCE_HARDWARE_LABEL=\nCORA_PERFORMANCE_GPU_LABEL=\n