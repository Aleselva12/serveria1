# Profilo suggerito per la prova prestazionale sul PC di sviluppo.
# Copiare questi valori nel proprio .env: non contiene credenziali.
CORA_PERFORMANCE_PROFILE=pc-max
CORA_MODEL_KEEP_ALIVE=30m
CORA_CONTEXT_TOKENS=16384
CORA_OUTPUT_TOKENS=1024
CORA_RUN_TIMEOUT_SECONDS=300
CORA_MODEL_TIMEOUT_SECONDS=120
CORA_RUN_QUEUE_SIZE=8

# Per il primo confronto usare lo stesso modello per tutti i ruoli.
# Impostare OLLAMA_MODEL al modello scelto e lasciare vuote le variabili CORA_MODEL_*.
CORA_MODEL_SUPERVISOR=
CORA_MODEL_RESEARCH=
CORA_MODEL_AUDIO=
CORA_MODEL_EMAIL=
CORA_MODEL_STRUCTURE=
CORA_MODEL_PROGRAMMER=

# Etichette facoltative mostrate insieme ai risultati.
CORA_PERFORMANCE_HARDWARE_LABEL=
CORA_PERFORMANCE_GPU_LABEL=
