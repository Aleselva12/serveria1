# Profilo sperimentale per il server Debian attuale.
# NON è pensato per la futura Tesla P40 / 64 GB.
CORA_PERFORMANCE_PROFILE=server-current
OLLAMA_MODEL=qwen3:0.6b
CORA_MODEL_KEEP_ALIVE=30m
CORA_CONTEXT_TOKENS=8192
CORA_OUTPUT_TOKENS=512
CORA_RUN_QUEUE_SIZE=4
CORA_RUN_TIMEOUT_SECONDS=300
CORA_MODEL_TIMEOUT_SECONDS=180
CORA_DB_POOL_SIZE=2
CORA_BACKGROUND_IDLE_SECONDS=120
CORA_EMBEDDING_BATCH_SIZE=1
CORA_MEMORY_EMBED_TIMEOUT_SECONDS=2
CORA_PERFORMANCE_HARDWARE_LABEL=Debian home server current hardware
CORA_PERFORMANCE_GPU_LABEL=CPU only
